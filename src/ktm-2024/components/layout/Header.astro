---
import Logo from "../../images/logo.svg";
---
<header class="bg-white shadow">
  <div class="container mx-auto px-4 py-2 flex items-center justify-between">
    <a class="flex w-48 h-16 sm:h-20 py-2 items-start" href="/">
      <img src={Logo.src} alt="BarCamp Kathmandu 2024" />
    </a>

    <button
      id="mobile-menu-toggle-2024"
      class="lg:hidden flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500"
      aria-expanded="false"
    >
      <svg id="hamburger-icon-2024" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="close-icon-2024" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="hidden lg:flex gap-2 items-center">
      <a
        class="rounded-full border border-black px-5 py-2 text-base font-medium text-black hover:bg-orange-700 hover:text-white"
        href="https://photos.app.goo.gl/2LzrpJiYpA5VrYVv6"
        target="_blank"
        rel="noopener noreferrer"
      >
        Event Photos
      </a>
    </div>
  </div>

  <div id="mobile-menu-2024" class="hidden lg:hidden flex flex-col items-center bg-white py-4 gap-4">
    <a
      class="rounded-full border border-black px-5 py-2 text-base font-medium text-black hover:bg-orange-700 hover:text-white"
      href="https://photos.app.goo.gl/2LzrpJiYpA5VrYVv6"
      target="_blank"
      rel="noopener noreferrer"
    >
      Event Photos
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle-2024');
  const mobileMenu = document.getElementById('mobile-menu-2024');
  const hamburgerIcon = document.getElementById('hamburger-icon-2024');
  const closeIcon = document.getElementById('close-icon-2024');

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.toggle('hidden');
      if (isHidden) {
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      } else {
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>
