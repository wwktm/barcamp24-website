---
import Layout2024 from '../../layouts/Layout2024.astro';
import EventDescription from '../../ktm-2024/components/homepage/EventDescription.astro';
import EventManagement from '../../ktm-2024/components/homepage/EventManagement.astro';
import Schedule from '../../ktm-2024/components/homepage/Schedule.astro';
import Faq from '../../ktm-2024/components/homepage/Faq.astro';
import scheduleBoard from '../../ktm-2024/images/schedule.jpeg';
---
<Layout2024>
  <EventDescription />
  <div class="proposals py-12">
    <div class="container mx-auto px-4">
      <h2 class="sm:text-3xl text-3xl font-bold mb-12 text-center">
        Scheduling Board
      </h2>
      <a href={scheduleBoard.src} target="_blank" rel="noopener noreferrer">
        <img src={scheduleBoard.src} alt="Scheduling Board" class="mx-auto max-w-full h-auto shadow-md rounded-lg" />
      </a>
    </div>
  </div>
  <EventManagement />
  <Schedule />
  <Faq />
</Layout2024>
