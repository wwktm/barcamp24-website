---
import Layout from '../layouts/Layout.astro';
import { announcement } from '../content/announcement';
import Hero from '../components/landing/Hero.astro';
import LeadStatement from '../components/landing/LeadStatement.astro';
import Topics from '../components/landing/Topics.astro';
import InviteCTA from '../components/landing/InviteCTA.astro';
import SpeakersCarousel from '../components/landing/SpeakersCarousel.astro';
import Faq from '../components/landing/Faq.astro';
import { getAcceptedSpeakers } from '../utils/sessions';

const { event, callForSpeakersOpen } = announcement;
const chips = [
  { icon: 'calendar' as const, label: event.date },
  { icon: 'pin' as const, label: event.venue.name },
];

// accepted proposals show up as soon as they're accepted, while the call is open
const speakers = callForSpeakersOpen ? await getAcceptedSpeakers() : [];

const rule = 'h-px bg-line max-w-[940px] mx-auto';
---
<Layout overlayHeader>
  <div class="bg-paper text-ink font-body">
    <Hero copy={announcement.hero} chips={chips} showCta={callForSpeakersOpen} />

    <div class={rule}></div>
    <LeadStatement />

    {callForSpeakersOpen && (
      <>
        <div class={rule}></div>
        <Topics />
        <InviteCTA />
      </>
    )}

    {speakers.length > 0 && (
      <>
        <div class={rule}></div>
        <SpeakersCarousel speakers={speakers} />
      </>
    )}

    <div class={rule}></div>
    <Faq />
  </div>
</Layout>
