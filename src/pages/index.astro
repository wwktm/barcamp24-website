---
import Layout from '../layouts/Layout.astro';
import { announcement } from '../content/announcement';
import { isActive } from '../content/phase';
import Hero from '../components/landing/Hero.astro';
import LeadStatement from '../components/landing/LeadStatement.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import Topics from '../components/landing/Topics.astro';
import InviteCTA from '../components/landing/InviteCTA.astro';
import SpeakersGrid from '../components/landing/SpeakersGrid.astro';
import { getAcceptedSpeakers } from '../utils/sessions';

const { event } = announcement;
const chips: { icon: string; label: string }[] = [];
chips.push({ icon: '📅', label: event.date }); // the hero shows the date only

// accepted proposals become the on-site speaker list (build-time read)
const speakers = isActive('speakers') ? await getAcceptedSpeakers() : [];

const rule = 'h-px bg-line max-w-[940px] mx-auto';
---
<Layout overlayHeader>
  <div class="bg-paper text-ink font-body">
    <Hero copy={announcement.hero.teaser} chips={chips} showCta={isActive('call-for-speakers')} />

    <div class={rule}></div>
    <LeadStatement />
    <div class={rule}></div>
    <HowItWorks />

    {isActive('call-for-speakers') && (
      <>
        <div class={rule}></div>
        <Topics />
        <InviteCTA />
      </>
    )}

    {isActive('speakers') && (
      <>
        <div class={rule}></div>
        <SpeakersGrid speakers={speakers} />
      </>
    )}
  </div>
</Layout>
