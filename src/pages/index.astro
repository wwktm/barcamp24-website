---
import Layout from '../layouts/Layout.astro';
import { announcement } from '../content/announcement';
import Hero from '../components/landing/Hero.astro';
import LeadStatement from '../components/landing/LeadStatement.astro';
import Topics from '../components/landing/Topics.astro';
import InviteCTA from '../components/landing/InviteCTA.astro';
import SpeakersGrid from '../components/landing/SpeakersGrid.astro';
import Partners from '../components/landing/Partners.astro';
import Faq from '../components/landing/Faq.astro';
import { getAcceptedSpeakers } from '../utils/sessions';

const { event, callForSpeakersOpen, afterwards } = announcement;
const chips = [
  { icon: 'calendar' as const, label: event.date },
  { icon: 'clock' as const, label: event.hours },
  { icon: 'pin' as const, label: event.venue.name },
];

// Deliberately not tied to the call being open: once it closes, this stops being
// a line-up and becomes the record of who actually spoke.
const speakers = await getAcceptedSpeakers();

const rule = 'h-px bg-line max-w-[940px] mx-auto';
---
<Layout overlayHeader>
  <div class="bg-paper text-ink font-body">
    <Hero
      copy={announcement.hero}
      chips={chips}
      showCta={callForSpeakersOpen}
      ticketsUrl={announcement.ticketsUrl}
      photosUrl={afterwards.photosUrl}
      feedbackUrl={afterwards.feedbackUrl}
    />

    <div class={rule}></div>
    <LeadStatement />

    {callForSpeakersOpen && (
      <>
        <div class={rule}></div>
        <Topics />
      </>
    )}

    {speakers.length > 0 && (
      <>
        <div class={rule}></div>
        <SpeakersGrid speakers={speakers} />
      </>
    )}

    {callForSpeakersOpen && <InviteCTA />}

    <div class={rule}></div>
    <Partners />

    <div class={rule}></div>
    <Faq />
  </div>
</Layout>
