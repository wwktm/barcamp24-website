---
import Layout from '../layouts/Layout.astro';
import { announcement } from '../content/announcement';
import { isActive } from '../content/phase';
import Hero from '../components/landing/Hero.astro';
import LeadStatement from '../components/landing/LeadStatement.astro';
import Topics from '../components/landing/Topics.astro';
import InviteCTA from '../components/landing/InviteCTA.astro';
import SpeakersGrid from '../components/landing/SpeakersGrid.astro';
import Faq from '../components/landing/Faq.astro';

const { event } = announcement;
const chips: { icon: string; label: string }[] = [];
chips.push({ icon: '📅', label: event.date }); // event date shown from the teaser phase
if (isActive('venue')) chips.push({ icon: '📍', label: event.venue.name });
if (isActive('date')) chips.push({ icon: '🎟', label: event.entry });

const rule = 'h-px bg-line max-w-[940px] mx-auto';
---
<Layout overlayHeader>
  <div class="bg-paper text-ink font-body">
    <Hero copy={announcement.hero[announcement.currentPhase]} chips={chips} showCta={isActive('call-for-speakers')} />

    <div class={rule}></div>
    <LeadStatement />

    {isActive('call-for-speakers') && (
      <>
        <div class={rule}></div>
        <Topics />
        <InviteCTA />
      </>
    )}

    {isActive('speakers') && (
      <>
        <div class={rule}></div>
        <SpeakersGrid speakers={announcement.speakers} />
      </>
    )}

    <div class={rule}></div>
    <Faq />
  </div>
</Layout>
