---
const slogans = [
  "Cutting-edge technology",
  "Peer to Peer web",
  "Nepalese Tech Companies",
  "Internet governance",
  "Technology for social good",
];
---
<section class="sm:-mt-36 mx-auto">
  <div class="overflow-x-hidden">
    <div class="animate-marquee sm:animate-none flex gap-3 sm:justify-center">
      {Array.from({ length: 5 }, (_, index) => index).map((imageIndex) => (
        <img
          class="max-h-64"
          src={`/homepage-images/image-${imageIndex}.jpg`}
          alt="BarCamp Event"
        />
      ))}
    </div>
    <div class="py-3 bg-orange-500 sm:-rotate-1 sm:-mt-8 sm:mb-10">
      <div class="overflow-x-hidden">
        <div class="animate-marquee sm:animate-none flex gap-3 sm:justify-center">
          {slogans.map((slogan) => (
            <div class="flex gap-2">
              <div>&#128293;</div>
              <div class="font-bold text-white">{slogan}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
