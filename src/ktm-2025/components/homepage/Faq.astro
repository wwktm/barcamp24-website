---
// Content lives in src/content/faq.ts and is shared with the 2024 and 2026 sites.
// Only the markup below is 2025-specific.
import { faqs } from '../../../content/faq';
---
<div id="faq" class="py-14">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-6xl">
      <h2 class="sm:text-3xl text-3xl font-bold mb-12 text-center">
        Frequently asked questions
      </h2>
      <dl class="mt-10 space-y-8 divide-y divide-gray-300">
        {faqs.map((item, i) => (
          <details class="group pt-6" open={i === 0}>
            <summary class="flex w-full items-start justify-between text-left text-black cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <span class="text-lg font-semibold leading-7">
                {item.q}
              </span>
              <span class="ml-6 flex h-7 items-center">
                <svg class="h-6 w-6 group-open:hidden text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                <svg class="h-6 w-6 hidden group-open:block text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
                </svg>
              </span>
            </summary>
            <dd class="mt-2 pr-12">
              <div class="flex flex-col gap-3 text-base leading-7 text-gray-800 [&_a]:text-orange-500 [&_a:hover]:underline [&_strong]:font-semibold">
                {item.a.map((para) => <p set:html={para} />)}
              </div>
            </dd>
          </details>
        ))}
      </dl>
    </div>
  </div>
</div>
