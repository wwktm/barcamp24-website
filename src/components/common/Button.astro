---
interface Props {
  variant?: "primary" | "outline";
  href?: string;
  class?: string;
}

const { variant = "primary", href, class: className = "" } = Astro.props;

const base =
  "font-sans font-bold text-[15px] rounded-[10px] px-7 py-3.5 inline-flex gap-2 items-center no-underline cursor-pointer transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400";

const variants = {
  primary: "bg-brand text-white hover:bg-brand-deep",
  outline: "bg-transparent text-ink border-[1.5px] border-line hover:border-ink",
};

const classes = [base, variants[variant], className].filter(Boolean).join(" ");
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type="button" class={classes}>
      <slot />
    </button>
  )
}
