---
const pathname = Astro.url.pathname;
const is2024 = pathname === '/ktm/2024' || pathname === '/ktm/2024/';
const is2025 = pathname === '/ktm/2025' || pathname === '/ktm/2025/';
---
{!is2024 && (
  <a
    class="rounded-full border-[1.5px] border-ink/35 px-5 py-2 font-display font-semibold text-[13.5px] text-ink no-underline transition-colors hover:border-brand hover:text-brand"
    href="/ktm/2024"
  >
    2024
  </a>
)}
{!is2025 && (
  <a
    class="rounded-full border-[1.5px] border-ink/35 px-5 py-2 font-display font-semibold text-[13.5px] text-ink no-underline transition-colors hover:border-brand hover:text-brand"
    href="/ktm/2025"
  >
    2025
  </a>
)}
