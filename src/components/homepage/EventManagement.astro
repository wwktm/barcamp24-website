---
import acmeLogo from "../../images/acem.png";
import eventsmoLogo from "../../images/eventsmo-logo.png";
import arbyteLogo from "../../images/arbyte.svg";
---
<div
  id="supporters"
  class="py-14 bg-gradient-to-l from-sky-100 to-orange-50 bg-gray-10"
>
  <div class="container mx-auto px-4">
    <h2 class="sm:text-3xl text-3xl font-bold mb-12 text-center">
      Supporters
    </h2>
    <div class="mx-auto grid max-w-lg grid-cols-2 justify-center items-start gap-x-8 gap-y-12 sm:max-w-xl sm:grid-cols-4 sm:gap-x-10 sm:gap-y-14 lg:mx-0 lg:max-w-none lg:grid-cols-4">
      <div class="flex flex-col gap-2 items-center">
        <h3 class="font-bold mb-4 text-center">Managed By</h3>
        <img
          alt="Web Weekend Kathmandu"
          src="https://wwktm.com/img/logo.png"
          class="max-h-20 w-full max-w-40 object-contain"
        />
      </div>
      <div class="flex flex-col gap-2 items-center">
        <h3 class="font-bold mb-4 text-center">Associate Partner</h3>
        <img
          alt="Advanced College of Engineering and Management"
          src={acmeLogo.src}
          class="max-h-20 w-full max-w-40 object-contain"
        />
      </div>
      <div class="flex flex-col gap-2 items-center">
        <h3 class="font-bold mb-4 text-center">Logistics Partner</h3>
        <img
          alt="Arbyte"
          src={arbyteLogo.src}
          class="max-h-20 w-full max-w-40 object-contain"
        />
      </div>
      <div class="flex flex-col gap-2 items-center">
        <h3 class="font-bold mb-4 text-center">Ticketing partner</h3>
        <img
          alt="Events Mo"
          src={eventsmoLogo.src}
          class="max-h-20 w-full max-w-40 object-contain"
        />
      </div>
    </div>
  </div>
</div>
