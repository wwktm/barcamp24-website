---
import Button from '../common/Button.astro';
import type { HeroCopy } from '../../content/announcement';

export type ChipIcon = 'calendar' | 'pin';

interface Props {
  copy: HeroCopy;
  chips: { icon: ChipIcon; label: string }[];
  showCta: boolean;
  /** Empty while tickets are not on sale, which hides the button. */
  ticketsUrl?: string;
}

const { copy, chips, showCta, ticketsUrl } = Astro.props;
const lines = copy.headline.split('\n');

const ICONS: Record<ChipIcon, string> = {
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="2.5" /><path d="M8 3v4M16 3v4M3 10.5h18" />',
  pin: '<path d="M20 10.3c0 5.7-8 11.7-8 11.7s-8-6-8-11.7a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.9" />',
};

const TICKET_ICON =
  '<path d="M3 8.2c0-.66.54-1.2 1.2-1.2h15.6c.66 0 1.2.54 1.2 1.2v2.3a2 2 0 0 0 0 3.9v2.4c0 .66-.54 1.2-1.2 1.2H4.2A1.2 1.2 0 0 1 3 16.8v-2.4a2 2 0 0 0 0-3.9V8.2Z" /><path d="M14.5 7.6v1.7m0 2.4v1.7m0 2.4v1.7" />';
const MIC_ICON =
  '<path d="M12 3.5a2.6 2.6 0 0 1 2.6 2.6v5.3a2.6 2.6 0 1 1-5.2 0V6.1A2.6 2.6 0 0 1 12 3.5Z" /><path d="M6.5 11a5.5 5.5 0 0 0 11 0M12 16.5V20m-2.7 0h5.4" />';
---
<header class="hero-liquid relative overflow-hidden text-center flex items-center justify-center min-h-[100svh] py-16">
  <canvas class="liquid-canvas" aria-hidden="true"></canvas>
  <div class="fade-bottom" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-[1040px] mx-auto px-[26px]">
    {copy.eyebrow && <div class="rise d1 font-display uppercase text-eyebrow text-brand-deep font-semibold">{copy.eyebrow}</div>}
    {chips.length > 0 && (
      <div class="rise d2 my-6 flex flex-wrap items-start justify-center gap-x-[26px] gap-y-2 text-soft font-display font-semibold text-[15px] sm:text-[17px]">
        {chips.map((c) => (
          <span class="inline-flex items-start gap-2.5">
            <svg
              class="w-[18px] h-[18px] mt-[2px] shrink-0 text-brand sm:w-[20px] sm:h-[20px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={ICONS[c.icon]}
            />
            <b class="text-ink">{c.label}</b>
          </span>
        ))}
      </div>
    )}
    <h1 class="hero-title rise d2 font-display text-display mt-4">
      {lines.map((line, i) => (
        <Fragment>{i > 0 && <br />}{i === lines.length - 1 && lines.length > 1 ? <span class="font-light text-brand">{line}</span> : line}</Fragment>
      ))}
    </h1>
    {copy.sub && <p class="rise d3 font-body text-soft text-[19px] max-w-[54ch] mx-auto my-7">{copy.sub}</p>}
    <div class="rise d4 flex gap-3 justify-center flex-wrap">
      {ticketsUrl && (
        <Button size="lg" href={ticketsUrl} target="_blank" rel="noopener noreferrer">
          <svg
            class="w-8 h-8 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={TICKET_ICON}
          />
          Get your ticket
        </Button>
      )}
      {showCta && (
        <Button size="lg" variant="outline" href="/submit-proposal">
          <svg
            class="w-6 h-6 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={MIC_ICON}
          />
          Submit a proposal
        </Button>
      )}
    </div>
    <div class="rise d4 mt-6">
      <a
        href="/#topics"
        class="font-display font-semibold text-[15px] text-soft hover:text-brand no-underline inline-flex items-center gap-1.5 transition-colors"
      >Browse topics <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</header>

<style>
  .hero-liquid { isolation: isolate; background: #f9f8f5; }

  .liquid-canvas {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    display: block;
  }

  .fade-bottom {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 46%; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom, rgba(249, 248, 245, 0) 0%, rgba(249, 248, 245, 0.7) 55%, #f9f8f5 100%);
  }

  .hero-title { position: relative; isolation: isolate; }
  .hero-title::before {
    content: "";
    position: absolute; inset: -18% -20%;
    z-index: -1;
    background: radial-gradient(ellipse at center, rgba(249, 248, 245, 0.82), rgba(249, 248, 245, 0) 72%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rise { opacity: 0; transform: translateY(16px); animation: hero-rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; }
    .d1 { animation-delay: 0.05s; }
    .d2 { animation-delay: 0.18s; }
    .d3 { animation-delay: 0.34s; }
    .d4 { animation-delay: 0.5s; }
    @keyframes hero-rise { to { opacity: 1; transform: none; } }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const hero = document.querySelector('.hero-liquid') as HTMLElement | null;
  const canvas = hero ? (hero.querySelector('.liquid-canvas') as HTMLCanvasElement | null) : null;
  const gl = canvas ? canvas.getContext('webgl', { antialias: false, alpha: false, premultipliedAlpha: false }) : null;

  if (hero && canvas && gl) {
    const VERT = 'attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }';
    const FRAG = [
      'precision highp float;',
      'uniform vec2 res; uniform float t; uniform vec2 mouse; uniform float mAmt;',
      // sine-free hash (Dave Hoskins) -- precision-stable on mobile GPUs, no blocky tiles
      'float hash(vec2 x){',
      '  vec3 p3 = fract(vec3(x.xyx) * 0.1031);',
      '  p3 += dot(p3, p3.yzx + 33.33);',
      '  return fract((p3.x + p3.y) * p3.z);',
      '}',
      'float noise(vec2 p){',
      '  vec2 i = floor(p); vec2 f = fract(p);',
      '  vec2 u = f * f * (3.0 - 2.0 * f);',
      '  return mix(mix(hash(i + vec2(0.0,0.0)), hash(i + vec2(1.0,0.0)), u.x),',
      '             mix(hash(i + vec2(0.0,1.0)), hash(i + vec2(1.0,1.0)), u.x), u.y);',
      '}',
      'float fbm(vec2 p){ float v = 0.0; float a = 0.5; for(int i=0;i<4;i++){ v += a*noise(p); p *= 2.03; a *= 0.5; } return v; }',
      'void main(){',
      '  vec2 uv = gl_FragCoord.xy / res.xy;',
      '  vec2 asp = vec2(res.x/res.y, 1.0);',
      '  vec2 p = uv * asp * 2.3;',
      '  float tt = t * 0.05;',
      '  vec2 q = vec2(fbm(p + vec2(0.0, tt)), fbm(p + vec2(5.2, 1.3 - tt)));',
      '  vec2 m = mouse * asp * 2.3;',
      '  vec2 md = p - m; float mdist = length(md);',
      '  vec2 swirl = vec2(-md.y, md.x) / (mdist + 0.55) * mAmt * 0.7 * exp(-mdist * 0.9);',
      '  vec2 r = vec2(fbm(p + q * 1.9 + swirl + vec2(1.7, 9.2) + tt),',
      '                fbm(p + q * 1.9 + swirl + vec2(8.3, 2.8) - tt));',
      '  float f = fbm(p + r * 1.7);',
      '  vec3 paper = vec3(0.976, 0.973, 0.961);',
      '  vec3 sky = vec3(0.220, 0.741, 0.973);',
      '  vec3 org = vec3(0.976, 0.451, 0.086);',
      '  vec3 col = paper;',
      '  col = mix(col, mix(paper, sky, 0.42), smoothstep(0.32, 0.78, f + 0.22 * q.x));',
      '  col = mix(col, mix(paper, org, 0.4), smoothstep(0.54, 0.98, r.y + 0.15 * q.y));',
      '  col = mix(paper, col, 0.72);',
      '  gl_FragColor = vec4(col, 1.0);',
      '}'
    ].join('\n');

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error('shader', gl.getShaderInfoLog(s));
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'res');
    const uT = gl.getUniformLocation(prog, 't');
    const uMouse = gl.getUniformLocation(prog, 'mouse');
    const uMAmt = gl.getUniformLocation(prog, 'mAmt');

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const scale = 0.8;
    let W = 0, H = 0;
    const resize = () => {
      const r = hero.getBoundingClientRect();
      W = Math.max(1, Math.round(r.width * dpr * scale));
      H = Math.max(1, Math.round(r.height * dpr * scale));
      canvas.width = W;
      canvas.height = H;
      gl.viewport(0, 0, W, H);
    };
    resize();
    window.addEventListener('resize', resize);

    let mx = 0.5, my = 0.5, tmx = 0.5, tmy = 0.5, amt = 0, tAmt = 0;
    if (fine) {
      hero.addEventListener('mousemove', (e) => {
        const r = hero.getBoundingClientRect();
        tmx = (e.clientX - r.left) / r.width;
        tmy = 1.0 - (e.clientY - r.top) / r.height;
        tAmt = 1;
      });
      hero.addEventListener('mouseleave', () => { tAmt = 0; });
    }

    const start = performance.now();
    const render = (now: number) => {
      const t = (now - start) / 1000;
      mx += (tmx - mx) * 0.06;
      my += (tmy - my) * 0.06;
      amt += (tAmt - amt) * 0.05;
      gl.uniform2f(uRes, W, H);
      gl.uniform1f(uT, t);
      gl.uniform2f(uMouse, mx, my);
      gl.uniform1f(uMAmt, amt);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!reduce) requestAnimationFrame(render);
    };
    if (reduce) render(start + 6000);
    else requestAnimationFrame(render);
  }
</script>
