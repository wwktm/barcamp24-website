---
import { Image } from 'astro:assets';
import scheduleBoard from '../../ktm-2024/images/schedule.jpeg';
import board2025 from '../../images/barcamp-2025/photo-5.jpg';
import groupPhoto2025 from '../../images/barcamp-2025/photo-2.jpg';
import thanks2025a from '../../images/barcamp-2025/photo-1.jpg';
import thanks2025b from '../../images/barcamp-2025/photo-3.jpg';
import entrance2025 from '../../images/barcamp-2025/photo-4.jpg';

/**
 * Continuously scrolling photo strip.
 *
 * Every photo renders at a fixed height with width:auto rather than being
 * stretched to fill, so aspect ratios stay untouched and the tall shots read as
 * tall. The track holds the list twice and slides exactly -50%, which is what
 * makes the loop seamless; the spacing lives in each item's padding rather than
 * a flex `gap` so the two copies stay exactly the same width.
 */

/** The desktop display height the srcset is sized against (see .h-\[360px\] below). */
const DISPLAY_H = 360;

/** Rendered width of an imported image once it is scaled to DISPLAY_H. */
const displayWidth = (a: { width: number; height: number }) =>
  Math.round(DISPLAY_H * (a.width / a.height));

/*
 * Ordered to alternate wide and tall so the strip has some rhythm, and to open
 * on the two session boards — the paragraph above is about that timetable.
 */
const ITEMS = [
  {
    asset: scheduleBoard,
    alt: 'The session board at BarCamp Kathmandu 2024: a wall-sized grid of tracks and time slots, filled in by hand with session cards.',
  },
  {
    asset: board2025,
    alt: 'The 2025 session board: a whiteboard grid of rooms and time slots covered in handwritten session cards, with attendees reading it.',
  },
  {
    src: '/homepage-images/image-1.jpg',
    width: 380,
    height: 300,
    alt: 'Attendees crowded around the printed session grid, reading the day’s tracks.',
  },
  {
    asset: groupPhoto2025,
    alt: 'The BarCamp Kathmandu 2025 group photo: around a hundred and fifty attendees filling the tiers of an outdoor amphitheatre.',
  },
  {
    src: '/homepage-images/image-4.jpg',
    width: 230,
    height: 300,
    alt: 'A speaker presenting at a whiteboard to a seated room.',
  },
  {
    asset: thanks2025a,
    alt: 'A speaker being handed a framed BarCamp thank-you certificate in one of the session rooms.',
  },
  {
    src: '/homepage-images/image-2.jpg',
    width: 380,
    height: 300,
    alt: 'The BarCamp Kathmandu group photo on the steps outside the venue.',
  },
  {
    asset: entrance2025,
    alt: 'The venue entrance in 2025, with a BarCamp Kathmandu roll-up banner beside the doors.',
  },
  {
    src: '/homepage-images/image-0.jpg',
    width: 230,
    height: 300,
    alt: 'The BarCamp flame logo standee at the venue entrance.',
  },
  {
    asset: thanks2025b,
    alt: 'Two organisers holding up a framed BarCamp thank-you certificate for the camera.',
  },
  {
    src: '/homepage-images/image-3.jpg',
    width: 380,
    height: 300,
    alt: 'Attendees gathered in the open corridor as someone addresses the group.',
  },
];
---

<div class="marquee relative">
  <div class="viewport overflow-hidden">
    <div class="track">
      {[0, 1].map((copy) => (
        <div class="copy flex" aria-hidden={copy === 1 ? 'true' : undefined}>
          {ITEMS.map((item) => (
            <div class="pr-4 shrink-0">
              {item.asset ? (
                <Image
                  src={item.asset}
                  alt={copy === 0 ? item.alt : ''}
                  widths={[displayWidth(item.asset), displayWidth(item.asset) * 2]}
                  sizes={`${displayWidth(item.asset)}px`}
                  class="h-[240px] sm:h-[360px] w-auto rounded-xl border border-line bg-card object-cover block"
                />
              ) : (
                <img
                  src={item.src}
                  alt={copy === 0 ? item.alt : ''}
                  width={item.width}
                  height={item.height}
                  {/* not lazy: a horizontally-scrolled item can fail to trip the
                      intersection check and leave a blank frame mid-loop.
                      All five together are ~680KB. */}
                  decoding="async"
                  class="h-[240px] sm:h-[360px] w-auto rounded-xl border border-line bg-card object-cover block"
                />
              )}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="edge edge-left" aria-hidden="true"></div>
  <div class="edge edge-right" aria-hidden="true"></div>
</div>

<style>
  .track {
    display: flex;
    width: max-content;
    animation: gallery-scroll 60s linear infinite;
  }

  /* Slowing to a stop on hover keeps a photo readable without controls. */
  .marquee:hover .track,
  .marquee:focus-within .track {
    animation-play-state: paused;
  }

  @keyframes gallery-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /*
   * The edges echo the hero's cloud shader rather than being a flat paper wash.
   * Those two tints are the shader's own output, not eyeballed: it mixes paper
   * with sky at 0.42 and with orange at 0.4, then washes the result back toward
   * paper at 0.72 — which lands on #bfe6f6 and #f9d2b5.
   *
   * Soft blobs supply the cloud; a mask dissolves the whole layer inward, so the
   * photos emerge from the gradient instead of meeting a hard line. Purely
   * decorative: aria-hidden in the markup, and pointer-events:none so nothing
   * here is hoverable, clickable, or able to swallow a scroll.
   */
  .edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(88px, 15vw, 260px);
    pointer-events: none;
    background:
      /* cloud tints: present at the screen edge, gone well before the inner end */
      radial-gradient(
        135% 95% at 0% 16%,
        rgba(191, 230, 246, 0.8) 0%,
        rgba(191, 230, 246, 0.34) 30%,
        rgba(191, 230, 246, 0) 66%
      ),
      radial-gradient(
        120% 85% at 0% 94%,
        rgba(249, 210, 181, 0.66) 0%,
        rgba(249, 210, 181, 0.26) 32%,
        rgba(249, 210, 181, 0) 68%
      ),
      /*
       * The paper veil that actually hides the cut edge. Opacity eases the whole
       * way to zero with no opaque plateau — a plateau is what reads as a solid
       * block ending in a hard line. Stops are dense enough to avoid banding.
       */
        linear-gradient(
          to right,
          rgba(249, 248, 245, 1) 0%,
          rgba(249, 248, 245, 0.97) 9%,
          rgba(249, 248, 245, 0.9) 20%,
          rgba(249, 248, 245, 0.78) 32%,
          rgba(249, 248, 245, 0.62) 44%,
          rgba(249, 248, 245, 0.44) 57%,
          rgba(249, 248, 245, 0.27) 70%,
          rgba(249, 248, 245, 0.13) 83%,
          rgba(249, 248, 245, 0.04) 93%,
          rgba(249, 248, 245, 0) 100%
        );
  }
  .edge-left {
    left: 0;
  }
  /* Mirrored so one gradient and one mask serve both sides. */
  .edge-right {
    right: 0;
    transform: scaleX(-1);
  }

  /*
   * No motion: drop the animation and the duplicate copy, and hand the strip
   * over as a normal scroll container so every photo is still reachable.
   */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
    .copy[aria-hidden='true'] {
      display: none;
    }
    .viewport {
      overflow-x: auto;
    }
    .edge {
      display: none;
    }
  }
</style>
