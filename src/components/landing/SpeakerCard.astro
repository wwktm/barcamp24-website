---
import { Image } from 'astro:assets';
import type { DisplaySpeaker } from '../../utils/sessions';

interface Props {
  speaker: DisplaySpeaker;
}

const { speaker } = Astro.props;

const initials = speaker.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join('');
---
<div class="bg-card border border-line rounded-2xl overflow-hidden">
  {speaker.photo ? (
    <Image src={speaker.photo} alt={speaker.name} width={480} height={480} class="w-full aspect-square object-cover" />
  ) : (
    /* initials sit underneath; a submitted photo covers them, and removes
       itself if the remote URL is dead so the initials show through */
    <div class="relative w-full aspect-square flex items-center justify-center bg-gradient-to-l from-sky-100 to-orange-50">
      <span class="font-display font-extrabold text-[42px] text-ink/40">{initials}</span>
      {speaker.photoUrl && (
        <img
          src={speaker.photoUrl}
          alt={speaker.name}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover"
          onerror="this.remove()"
        />
      )}
    </div>
  )}
  <div class="p-5">
    <h3 class="font-display font-bold text-[17px] text-ink">{speaker.name}</h3>
    {speaker.title && <p class="font-display text-[14px] text-brand-deep mt-1">{speaker.title}</p>}
    {speaker.tagline && <p class="text-soft text-[13.5px] mt-2">{speaker.tagline}</p>}
    {speaker.link && (
      <a href={speaker.link} target="_blank" rel="noopener noreferrer" class="inline-block mt-3 font-display font-semibold text-[13px] text-brand hover:text-brand-deep no-underline">Profile →</a>
    )}
  </div>
</div>
