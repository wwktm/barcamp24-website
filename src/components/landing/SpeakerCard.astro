---
import { Image } from 'astro:assets';
import type { DisplaySpeaker } from '../../utils/sessions';

interface Props {
  speaker: DisplaySpeaker;
  /** Position in the lineup, printed as the ticket number. */
  index: number;
}

const { speaker, index } = Astro.props;

const initials = speaker.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join('');

const DURATION_LABELS: Record<string, string> = {
  lightning: 'Lightning talk',
  regular: 'Full session',
};
const durationLabel = speaker.duration ? DURATION_LABELS[speaker.duration] : undefined;

const ticketNo = String(index + 1).padStart(2, '0');
// Three is what fits on one line at the narrowest card width.
const tags = (speaker.tags ?? []).slice(0, 3);
---
<article class="ticket group relative flex flex-col h-full bg-card border border-line rounded-2xl transition duration-200 hover:-translate-y-1 hover:border-brand/40 hover:shadow-[0_14px_30px_-12px_rgba(32,35,58,0.18)]">
  <div class="flex flex-col grow p-5 pb-4">
    <div class="flex items-baseline justify-between gap-3">
      {speaker.category ? (
        <p class="font-display font-semibold text-[10.5px] uppercase tracking-[0.16em] text-brand-deep truncate">{speaker.category}</p>
      ) : (
        <span></span>
      )}
      <p class="font-display font-bold text-[11px] text-faint shrink-0 tabular-nums">No. {ticketNo}</p>
    </div>

    <h3 class="font-display font-bold text-[18px] leading-[1.25] text-ink mt-3 line-clamp-3">{speaker.title}</h3>

    {speaker.description && (
      <p class="text-soft text-[13px] leading-[1.5] mt-2.5 line-clamp-2">{speaker.description}</p>
    )}

    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5 mt-4 list-none p-0">
        {tags.map((tag) => (
          <li class="font-display text-[11px] font-medium text-soft bg-paper border border-line rounded-full px-2.5 py-1">{tag}</li>
        ))}
      </ul>
    )}
  </div>

  {/* The tear: a dashed rule, with a punched hole bitten out of each edge. The
      holes are filled with the page colour, which is what makes them read as
      holes rather than as dots. */}
  <div class="relative">
    <div class="absolute inset-x-4 top-1/2 -translate-y-1/2 border-t border-dashed border-line"></div>
    <div class="absolute -left-[7px] top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-paper border border-line"></div>
    <div class="absolute -right-[7px] top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-paper border border-line"></div>
    <div class="h-4"></div>
  </div>

  <div class="flex items-center gap-3 p-5 pt-1">
    {/* initials sit underneath; a photo covers them, and a dead remote URL
        removes itself so the initials show through */}
    <div class="relative shrink-0 w-11 h-11 rounded-full overflow-hidden flex items-center justify-center bg-gradient-to-l from-sky-100 to-orange-50 ring-1 ring-line">
      <span class="font-display font-bold text-[13px] text-ink/45">{initials}</span>
      {speaker.photo ? (
        <Image src={speaker.photo} alt="" width={88} height={88} class="absolute inset-0 w-full h-full object-cover" />
      ) : speaker.photoUrl ? (
        <img
          src={speaker.photoUrl}
          alt=""
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover"
          onerror="this.remove()"
        />
      ) : null}
    </div>

    <div class="min-w-0 grow">
      {speaker.link ? (
        <a
          href={speaker.link}
          target="_blank"
          rel="noopener noreferrer"
          class="block truncate font-display font-semibold text-[14px] text-ink hover:text-brand no-underline"
        >{speaker.name}</a>
      ) : (
        <p class="truncate font-display font-semibold text-[14px] text-ink">{speaker.name}</p>
      )}
      <p class="text-faint text-[11.5px] mt-0.5 truncate">
        {durationLabel && <span>{durationLabel}</span>}
        {durationLabel && <span class="mx-1.5 text-line">·</span>}
        <span class="font-display uppercase tracking-[0.14em] text-[10px]">Admit one</span>
      </p>
    </div>
  </div>
</article>

<style>
  @media (prefers-reduced-motion: reduce) {
    .ticket {
      transition: none;
    }
    .ticket:hover {
      transform: none;
    }
  }
</style>
