---
import { Image } from 'astro:assets';
import type { DisplaySpeaker } from '../../utils/sessions';

interface Props {
  speaker: DisplaySpeaker;
}

const { speaker } = Astro.props;

const initials = speaker.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join('');

const DURATION_LABELS: Record<string, string> = {
  lightning: 'Lightning talk',
  regular: 'Full session',
};
const durationLabel = speaker.duration ? DURATION_LABELS[speaker.duration] : undefined;

// Three is what fits on one line at the narrowest card width.
const tags = (speaker.tags ?? []).slice(0, 3);
---
{/*
  The tear is made by the card's own borders, so nothing has to be aligned.

  The card is two stacked blocks: a body and a speaker stub. The body's bottom
  corners and the stub's top corners are rounded by the same radius, so where
  they meet the outline curves inward and straight back out. That pinch IS the
  notch. Because it is the elements' own border-radius, the outline is
  continuous by construction, and the background is clipped to the rounded box,
  so the bite is genuinely transparent and the page shows through it.

  Two earlier approaches are deliberately not used here. A mask needs
  mask-composite to punch two holes on one element, and when that does not apply
  the layers union and quietly cancel both holes out. Overlaying an arc on top
  of a break in the border leaves a seam, because a 1px line and a 1px arc drawn
  by different boxes never quite meet.
*/}
{/*
  No hover shadow. A shadow is drawn outside the card's rectangle, so it never
  reaches inside the notch — which left the bite lighter than the shadowed page
  right next to it, and read as a patch instead of a hole. The lift and the
  border warming carry the hover on their own.
*/}
<div class="ticket group relative h-full transition-transform duration-200 hover:-translate-y-1">
  <article class="relative flex flex-col h-full">
    <div class="ticket-edge body grow bg-card border border-line border-b-0 rounded-t-2xl p-5 pb-4 flex flex-col">
      {speaker.category && (
        <p class="font-display font-semibold text-[10.5px] uppercase tracking-[0.16em] text-brand-deep truncate">{speaker.category}</p>
      )}

      {/* Uppercased in CSS, not in the text, so the real title is what gets read
          out and indexed. Caps run wider, hence the slightly smaller size. */}
      <h3 class="font-display font-bold text-[17px] uppercase tracking-[0.015em] leading-[1.28] text-ink mt-3 line-clamp-3">{speaker.title}</h3>

      {speaker.description && (
        <p class="text-soft text-[13px] leading-[1.5] mt-2.5 line-clamp-2">{speaker.description}</p>
      )}

      {tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5 mt-4 list-none p-0">
          {tags.map((tag) => (
            <li class="font-display text-[11px] font-medium text-soft bg-paper border border-line rounded-full px-2.5 py-1">{tag}</li>
          ))}
        </ul>
      )}
    </div>

    <div class="ticket-edge flex items-center gap-3 px-5 bg-card border border-line border-t-0 rounded-b-2xl stub">
      {/* initials sit underneath; a photo covers them, and a dead remote URL
          removes itself so the initials show through */}
      <div class="relative shrink-0 w-11 h-11 rounded-full overflow-hidden flex items-center justify-center bg-gradient-to-l from-sky-100 to-orange-50 ring-1 ring-line">
        <span class="font-display font-bold text-[13px] text-ink/45">{initials}</span>
        {speaker.photo ? (
          <Image src={speaker.photo} alt="" width={88} height={88} class="absolute inset-0 w-full h-full object-cover" />
        ) : speaker.photoUrl ? (
          <img
            src={speaker.photoUrl}
            alt=""
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover"
            onerror="this.remove()"
          />
        ) : null}
      </div>

      <div class="min-w-0 grow">
        {speaker.link ? (
          <a
            href={speaker.link}
            target="_blank"
            rel="noopener noreferrer"
            class="block truncate font-display font-semibold text-[14px] text-ink hover:text-brand no-underline"
          >{speaker.name}</a>
        ) : (
          <p class="truncate font-display font-semibold text-[14px] text-ink">{speaker.name}</p>
        )}
        {durationLabel && <p class="text-faint text-[11.5px] mt-0.5 truncate">{durationLabel}</p>}
      </div>
    </div>
    <div class="tear-rule"></div>
  </article>
</div>

<style>
  .ticket {
    --notch-r: 10px;
    --stub-h: 68px;
  }

  .stub {
    height: var(--stub-h);
  }

  /* the two radii that meet to form the notch */
  .body {
    border-bottom-left-radius: var(--notch-r);
    border-bottom-right-radius: var(--notch-r);
  }

  .stub {
    border-top-left-radius: var(--notch-r);
    border-top-right-radius: var(--notch-r);
  }

  /* sits on the seam between the two blocks, starting clear of the notch */
  .tear-rule {
    position: absolute;
    left: calc(var(--notch-r) + 4px);
    right: calc(var(--notch-r) + 4px);
    bottom: var(--stub-h);
    border-top: 1px dashed theme('colors.line');
  }

  /* set here rather than as a group-hover utility: Astro's scoping raises the
     base rule above a utility's specificity and the utility would lose */
  .ticket:hover .ticket-edge {
    border-color: theme('colors.brand.DEFAULT / 40%');
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket {
      transition: none;
    }
    .ticket:hover {
      transform: none;
    }
  }
</style>
