---
import Section from '../common/Section.astro';
import { faqs } from '../../content/faq';

// Answers arrive from src/content/faq.ts as class-free HTML so every year can style
// them in its own design; the arbitrary variants below are this year's treatment.
const answerProse = [
  '[&_a]:text-brand [&_a]:font-semibold [&_a]:no-underline [&_a:hover]:text-brand-deep [&_a:hover]:underline',
  '[&_strong]:font-semibold [&_strong]:text-ink',
  '[&_em]:italic',
].join(' ');
---
<Section id="faq" heading="Frequently asked questions">
  <dl class="mt-8 border-t border-line">
    {faqs.map((item) => (
      <div class="border-b border-line">
        <details class="group">
          <summary
            class="flex items-start justify-between gap-6 cursor-pointer list-none py-5 [&::-webkit-details-marker]:hidden"
          >
            <dt class="font-display font-semibold text-[17px] text-ink transition-colors group-hover:text-brand group-open:text-brand">
              {item.q}
            </dt>
            <span
              class="shrink-0 mt-0.5 text-brand transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <dd class={`pb-6 pr-10 flex flex-col gap-3 text-soft text-[16px] leading-7 [&_p]:font-body [&_p]:font-normal ${answerProse}`}>
            {item.a.map((para) => <p set:html={para} />)}
          </dd>
        </details>
      </div>
    ))}
  </dl>
</Section>
