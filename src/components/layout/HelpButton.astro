---
import { announcement } from '../../content/announcement';

const digits = announcement.whatsappNumber.replace(/\D/g, '');
const href = digits ? `https://wa.me/${digits}` : '';
---
{href && (
  <a
    class="help-fab"
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Message the BarCamp organisers on WhatsApp"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="help-fab-icon">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.298.347-.497.115-.198.058-.372-.018-.52-.075-.148-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.4" />
    </svg>
    <span class="help-fab-label">Need help?</span>
  </a>
)}

<style>
  .help-fab {
    position: fixed;
    z-index: 40;
    right: 1rem;
    /* Clears the iOS home indicator, which otherwise sits under the button. */
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    /* 20px glyph + this padding clears the 44px minimum touch target. */
    padding: 0.8125rem;
    border: 1px solid theme('colors.line');
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: blur(10px);
    color: theme('colors.ink');
    box-shadow:
      0 1px 2px rgb(32 35 58 / 0.04),
      0 8px 24px rgb(32 35 58 / 0.07);
    transition:
      border-color 200ms,
      box-shadow 200ms,
      transform 200ms;
  }

  .help-fab-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: #25d366;
  }

  .help-fab-label {
    display: none;
    font-family: theme('fontFamily.display');
    font-weight: 600;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .help-fab:hover {
    border-color: theme('colors.brand.DEFAULT / 40%');
    box-shadow:
      0 1px 2px rgb(32 35 58 / 0.04),
      0 12px 28px rgb(32 35 58 / 0.1);
  }

  .help-fab:focus-visible {
    outline: 2px solid theme('colors.sky.400');
    outline-offset: 2px;
  }

  /* Icon-only on phones, where a pill covers too much of the page. */
  @media (min-width: 640px) {
    .help-fab {
      right: 1.5rem;
      bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
      padding: 0.625rem 1rem 0.625rem 0.8125rem;
    }

    .help-fab-label {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .help-fab:hover {
      transform: translateY(-2px);
    }
  }
</style>
